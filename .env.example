# 首次复制到 .env；已有 .env 请保留，不要用示例覆盖。
# 初始化后修改 MYSQL_* 不会修改已有数据卷的用户/密码/数据库。
# 同一电脑独立运行另一副本时，还要改项目名和两个宿主端口。
COMPOSE_PROJECT_NAME=material-studio
MYSQL_DATABASE=material_platform
MYSQL_USER=material_app
MYSQL_PASSWORD=CHANGE_ME_LOCAL_DB
MYSQL_ROOT_PASSWORD=CHANGE_ME_LOCAL_ROOT
MYSQL_PORT=13360
FRONTEND_PORT=3001
JAVA_API_ORIGIN=http://backend:8080
# Optional: set APP_ORIGIN when using a different hostname. Default follows FRONTEND_PORT.
# APP_ORIGIN=http://localhost:3001
SESSION_COOKIE_SECURE=false

# Deterministic simulation defaults; no actual AI service is called.
SIM_VALIDATE_DELAY_MS=1000
SIM_GENERATE_DELAY_MS=5000
SIM_FINALIZE_DELAY_MS=1000
SIM_FAIL_AT_STEP=NONE
TASK_EXECUTOR_THREADS=2
TASK_EXECUTOR_QUEUE_CAPACITY=20
# Developer-only per-task overrides. When enabled, set a nonempty private key.
DEMO_SIMULATION_OVERRIDE_ENABLED=false
DEMO_CONTROL_KEY=

# 设计示例；应用实现后复制到项目根目录 .env，禁止提交真实 .env。
# 本文件不代表 Compose 或应用代码已经存在。
MYSQL_DATABASE=material_platform
MYSQL_USER=material_app
MYSQL_PASSWORD=CHANGE_ME_LOCAL_DB
MYSQL_ROOT_PASSWORD=CHANGE_ME_LOCAL_ROOT

# Compose 构建时传入 Next.js rewrite；本机 npm dev 改成 http://127.0.0.1:8080。
JAVA_API_ORIGIN=http://backend:8080
APP_ORIGIN=http://localhost:3000
STORAGE_ROOT=/data/material

SERVER_SERVLET_SESSION_COOKIE_NAME=MP_SESSION
SERVER_SERVLET_SESSION_COOKIE_HTTP_ONLY=true
SERVER_SERVLET_SESSION_COOKIE_SAME_SITE=lax
SERVER_SERVLET_SESSION_COOKIE_SECURE=false
SERVER_SERVLET_SESSION_TIMEOUT=30m
SPRING_SERVLET_MULTIPART_MAX_FILE_SIZE=5MB
SPRING_SERVLET_MULTIPART_MAX_REQUEST_SIZE=6MB

TASK_EXECUTOR_THREADS=2
TASK_EXECUTOR_QUEUE_CAPACITY=20
SIM_VALIDATE_DELAY_MS=1000
SIM_GENERATE_DELAY_MS=5000
SIM_FINALIZE_DELAY_MS=1000
SIM_FAIL_AT_STEP=NONE
DEMO_SIMULATION_OVERRIDE_ENABLED=false
# 只有开启上面的本地开发覆盖时设置；不得使用 NEXT_PUBLIC_ 前缀。
DEMO_CONTROL_KEY=
